<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux and macOS sibling of the Windows tray app: Avalonia UI, a StatusNotifier /
       NSStatusItem tray icon, and an AES-GCM vault whose key lives in the platform keyring.
       All logic is shared with Windows through TrayAuth.Core; everything here is platform
       plumbing and pixels. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>trayauth</AssemblyName>
    <RootNamespace>TrayAuth.Desktop</RootNamespace>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <!-- The clean-clone tray-icon fallback writes pixels through a raw framebuffer pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Pinned so the offline Flatpak build is deterministic: without this, the runtime-pack
         version follows whichever SDK patch does the build, and Flathub's SDK extension and
         the machine that generated nuget-sources.json would drift apart. -->
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <!-- QR decoding: ZXing does the finding, ImageSharp loads the pixels (no System.Drawing here). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrayAuth.Core\TrayAuth.Core.csproj" />
  </ItemGroup>

  <!-- Same convention as the Windows app: the ico is generated by tools/MakeIcon, so a clean
       clone still builds and the app falls back to a runtime-drawn icon. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\assets\icon.ico')">
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="TrayAuth.icon.ico" />
  </ItemGroup>

</Project>
