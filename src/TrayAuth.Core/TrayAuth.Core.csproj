<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared heart of TrayAuth: TOTP generation, account model, vault document, exports,
       imports, Google Authenticator migration. No UI, no Windows dependencies - this project
       must build and behave identically for the Windows tray app and the Linux one. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrayAuth.Core</RootNamespace>
    <AssemblyName>TrayAuth.Core</AssemblyName>
    <Version>1.1.0</Version>
    <!-- Must match TrayAuth.Desktop exactly. A RID-specific restore resolves runtime packs
         per project, so an unpinned project here picks whatever its SDK defaults to - which
         is a different patch inside Flathub's dotnet8 extension than on the machine that
         generated nuget-sources.json, and the offline build then fails on a missing package.
         Any new project in this tree needs the same pin. -->
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Windows ACL hardening in FileProtection; both are inert no-ops at runtime elsewhere. -->
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
  </ItemGroup>

</Project>
