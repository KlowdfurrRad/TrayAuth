<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable tests: everything here must run on Windows and Linux alike, because it tests
       the shared core both apps stand on. Windows-only behaviour (DPAPI vault, registry menu,
       System.Drawing QR decoding) is tested in TrayAuth.Tests instead. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TrayAuth.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrayAuth.Core\TrayAuth.Core.csproj" />
  </ItemGroup>

</Project>
